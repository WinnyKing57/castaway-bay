config_version=5

[application]

config/name="Castaway Bay"
config/description="Survie et construction sur une île déserte. Remake libre inspiré des jeux de survie insulaire."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.08, 0.12, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://autoload/game_state.gd"
Database="*res://autoload/database.gd"
Sfx="*res://autoload/sfx.gd"
SaveSystem="*res://autoload/save_system.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

