[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/recipe_data.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
id = "plank"
display_name = "Planche"
description = "Transformation 2 bois -> 4 planches."
category = "artisanal"
inputs = {"wood": 2}
outputs = {"plank": 4}
time_limit_multiplier := 0.5
